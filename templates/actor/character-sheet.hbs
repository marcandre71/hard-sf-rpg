{{!--
  Feuille de personnage, étape 2.
  Nom et champs stockés : document._source / system._source
  (docSource, systemSource, characteristics.*.base…).
  Colonne Actuelle : valeur dérivée, pas un input. Bornée 0 à 100
  (CONFIG.SOL.characteristicValueBounds). Décision Marc 17/10/2026.
  Bornes des champs stockés : CONFIG.SOL.characteristicFields (bounds).
  Base : 1 à 60.
  Identité, biographie, notes : formGroup sur les champs du schéma.
  Contacts et Défauts : zones de texte (StringField, plusieurs lignes).
  Réf. Fiche v0.2 §4. Pas de Vice ni de Lueur (Fiche v0.2 §5).
--}}
<section class="sol-sheet">
  <header class="sol-header">
    <img class="sol-portrait" src="{{actor.img}}" alt="{{docSource.name}}"
         data-action="editImage" data-edit="img" data-tooltip="{{localize 'SOL.Sheet.EditImage'}}">
    <div class="sol-identity">
      <p class="sol-type">{{localize "TYPES.Actor.character"}}</p>
      <label for="{{rootId}}-name">{{localize "SOL.Sheet.Name"}}</label>
      <input id="{{rootId}}-name" type="text" name="name" value="{{docSource.name}}">
    </div>
  </header>

  <h2 class="sol-section-title">{{localize "SOL.Character.identity"}}</h2>
  {{> "systems/sol-nouvelle-ere/templates/shared/field-groups.hbs" groups=identityGroups}}

  <label class="sol-block-label" for="{{rootId}}-contacts">{{localize "SOL.Character.contacts"}}</label>
  <textarea id="{{rootId}}-contacts" name="system.contacts" rows="4">{{systemSource.contacts}}</textarea>

  <label class="sol-block-label" for="{{rootId}}-flaws">{{localize "SOL.Character.flaws"}}</label>
  <textarea id="{{rootId}}-flaws" name="system.flaws" rows="4">{{systemSource.flaws}}</textarea>

  <h2 class="sol-section-title">{{localize "SOL.Sheet.Characteristics"}}</h2>
  <table class="sol-characteristics">
    <thead>
      <tr>
        <th class="sol-col-name">{{localize "SOL.Sheet.Characteristic"}}</th>
        <th>{{localize bounds.base.label}}</th>
        <th>{{localize bounds.origin.label}}</th>
        <th>{{localize bounds.advance.label}}</th>
        <th>{{localize bounds.temp.label}}</th>
        <th>{{localize "SOL.Field.value"}}</th>
      </tr>
    </thead>
    <tbody>
      {{#each characteristics as |c|}}
      <tr data-characteristic="{{c.key}}">
        <td class="sol-col-name">
          <span class="sol-abbr">{{localize c.abbr}}</span>
          <span class="sol-label">{{localize c.label}}</span>
        </td>
        {{!-- min/max lus dans characteristicFields. temp n'a pas de borne (Fiche v0.2 §4). --}}
        <td><input type="number" name="{{c.path}}.base" value="{{c.base}}" min="{{../bounds.base.min}}" max="{{../bounds.base.max}}" step="1"></td>
        <td><input type="number" name="{{c.path}}.origin" value="{{c.origin}}" min="{{../bounds.origin.min}}" max="{{../bounds.origin.max}}" step="1"></td>
        <td><input type="number" name="{{c.path}}.advance" value="{{c.advance}}" min="{{../bounds.advance.min}}" max="{{../bounds.advance.max}}" step="1"></td>
        <td><input type="number" name="{{c.path}}.temp" value="{{c.temp}}" step="1"></td>
        <td class="sol-value"><output>{{c.value}}</output></td>
      </tr>
      {{/each}}
    </tbody>
  </table>

  {{formGroup biography.field name="system.biography" value=biography.value rootId=rootId label=biography.label localize=true}}
  {{formGroup notes.field name="system.notes" value=notes.value rootId=rootId label=notes.label localize=true}}

  {{> "systems/sol-nouvelle-ere/templates/actor/item-list.hbs"}}
</section>
