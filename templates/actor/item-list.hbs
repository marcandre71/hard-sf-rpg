{{!--
  Objets embarqués sur un acteur. Contexte : prepareItemList
  (module/sheets/item-list.mjs). data-item-id + .draggable : glisser-déposer
  géré par ActorSheetV2. Le refus d'un type interdit est le hook preCreateItem.
--}}
<section class="sol-items-section">
  <h2 class="sol-section-title">{{localize "SOL.Sheet.Items"}}</h2>
  {{#if items.length}}
  <ul class="sol-items">
    {{#each items as |item|}}
    <li class="sol-item draggable" data-item-id="{{item.id}}" data-item-type="{{item.type}}">
      <img src="{{item.img}}" alt="">
      <button type="button" class="sol-item-name" data-action="openItem" data-item-id="{{item.id}}">{{item.name}}</button>
      <span class="sol-item-type">{{item.typeLabel}}</span>
      <button type="button" class="sol-item-delete" data-action="deleteItem" data-item-id="{{item.id}}"
              data-tooltip="{{localize 'SOL.Sheet.DeleteItem'}}">
        <i class="fa-solid fa-trash"></i>
      </button>
    </li>
    {{/each}}
  </ul>
  {{else}}
  <p class="sol-empty">{{localize "SOL.Sheet.NoItems"}}</p>
  {{/if}}
  {{#if itemTypes.length}}
  <div class="sol-create-item">
    {{!-- Sans attribut name : ce choix ne doit pas être enregistré sur l'acteur. --}}
    <select data-sol-item-type>
      {{#each itemTypes as |choice|}}
      <option value="{{choice.type}}">{{choice.label}}</option>
      {{/each}}
    </select>
    <button type="button" data-action="createItem">{{localize "SOL.Sheet.CreateItem"}}</button>
  </div>
  {{/if}}
</section>
