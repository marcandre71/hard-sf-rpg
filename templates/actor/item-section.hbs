{{!--
  Une section d'objets d'un seul type. Contexte : prepareSections
  (module/sheets/item-list.mjs), passé sous le nom `section`.
  data-item-id + .draggable : glisser-déposer géré par ActorSheetV2.
  Le bouton Créer porte data-item-type. Le refus d'un type interdit
  reste le hook preCreateItem.
--}}
<section class="sol-item-section">
  {{#unless hideTitle}}
  <h3 class="sol-section-title">{{localize section.title}}</h3>
  {{/unless}}
  {{#if section.items.length}}
  <ul class="sol-items">
    {{#each section.items as |item|}}
    <li class="sol-item draggable" data-item-id="{{item.id}}" data-item-type="{{item.type}}">
      <img src="{{item.img}}" alt="">
      <button type="button" class="sol-item-name" data-action="openItem">{{item.name}}</button>
      {{#if item.canRoll}}
      <button type="button" class="sol-item-roll" data-action="rollItem" data-tooltip="{{localize 'SOL.Roll.roll'}}">
        <i class="fa-solid fa-dice-d20"></i>
      </button>
      {{/if}}
      {{!-- Pas de name : sinon submitOnChange enverrait une mise à jour vide
            sur l'acteur. data-action écrit system.equipped de l'objet. --}}
      {{#if item.showEquipped}}
      <label class="sol-equipped">
        <input type="checkbox" data-action="toggleEquipped" {{#if item.equipped}}checked{{/if}}>
        {{localize "SOL.Field.equipped"}}
      </label>
      {{/if}}
      {{!-- Pas de name : sinon submitOnChange écrirait l'acteur. --}}
      {{#if item.showEndOfOrder}}
      <label class="sol-equipped" data-tooltip="{{localize 'SOL.Injury.endOfOrderHint'}}">
        <input type="checkbox" data-action="toggleEndOfOrder" {{#if item.endOfOrder}}checked{{/if}}>
        {{localize "SOL.Injury.endOfOrderShort"}}
      </label>
      {{/if}}
      {{#if item.showSeal}}
      <button type="button" class="sol-item-roll" data-action="sealItem">{{localize "SOL.Seal.apply"}}</button>
      {{/if}}
      {{#if item.fields.length}}
      <span class="sol-item-fields">
        {{#each item.fields as |field|}}
        <span class="sol-item-field{{#if field.tone}} sol-pill sol-pill-{{field.tone}}{{/if}}"><span class="sol-item-field-label">{{localize field.label}}</span> {{field.value}}</span>
        {{/each}}
      </span>
      {{/if}}
      {{#if item.ammoMax}}
      <span class="sol-ammo">
        <span class="sol-num">{{item.ammoValue}} / {{item.ammoMax}}</span>
        <span class="sol-gauge" role="meter" aria-valuemin="0" aria-valuemax="{{item.ammoMax}}" aria-valuenow="{{item.ammoValue}}"
              aria-label="{{localize 'SOL.Weapon.ammo'}}">
          <span class="sol-gauge-fill" style="width: {{item.ammoPct}}%"></span>
        </span>
      </span>
      {{/if}}
      <button type="button" class="sol-item-edit" data-action="openItem" data-tooltip="{{localize 'SOL.Sheet.EditItem'}}">
        <i class="fa-solid fa-pen"></i>
      </button>
      <button type="button" class="sol-item-delete" data-action="deleteItem" data-tooltip="{{localize 'SOL.Sheet.DeleteItem'}}">
        <i class="fa-solid fa-trash"></i>
      </button>
    </li>
    {{/each}}
  </ul>
  {{else}}
  <p class="sol-empty">{{localize section.empty}}</p>
  {{/if}}
  {{#if section.canCreate}}
  <div class="sol-create-item">
    <button type="button" data-action="createItem" data-item-type="{{section.type}}">{{localize "SOL.Sheet.CreateItem"}}</button>
  </div>
  {{/if}}
</section>
