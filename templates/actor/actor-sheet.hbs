{{!--
  Feuille générique (Créature, Synthétique, Drone, Véhicule).
  Le Vaisseau a sa propre feuille. Décision Marc 21/10/2026.
  Les champs viennent du schéma du type. Nom lu dans document._source.
  Objets groupés par type, même partiel que le personnage.
  Décision Marc 18/10/2026 : FOR, CON et Seuil si le modèle les a.
--}}
<section class="sol-sheet">
  <header class="sol-header">
    <button type="button" class="sol-portrait-button" data-action="editImage" data-edit="img"
            data-tooltip="{{localize 'SOL.Sheet.EditImage'}}"
            aria-label="{{localize 'SOL.Sheet.EditImage'}}">
      <img class="sol-portrait" src="{{actor.img}}" alt="{{docSource.name}}">
    </button>
    <div class="sol-identity">
      <p class="sol-type">{{localize typeLabel}}</p>
      <label for="{{rootId}}-name">{{localize "SOL.Sheet.Name"}}</label>
      <input id="{{rootId}}-name" type="text" name="name" value="{{docSource.name}}">
    </div>
  </header>

  {{#if characteristics}}
  <h2 class="sol-section-title">{{localize "SOL.Sheet.Characteristics"}}</h2>
  {{> "systems/sol-nouvelle-ere/templates/shared/characteristics-table.hbs"}}
  <p class="sol-seuil">{{localize "SOL.Damage.sb"}} : <strong>{{seuil}}</strong></p>
  {{#if showEndurance}}
  <div class="sol-endurance-line">
    <span class="sol-lbl">{{localize "SOL.Actor.endurance"}}</span>
    <span class="sol-num">{{enduranceCurrent}} / {{enduranceMax}}</span>
  </div>
  <div class="sol-gauge" role="meter" aria-valuemin="0" aria-valuemax="{{enduranceMax}}"
       aria-valuenow="{{enduranceCurrent}}" aria-label="{{localize 'SOL.Actor.endurance'}}">
    <span class="sol-gauge-fill" style="width: {{endurancePct}}%"></span>
  </div>
  {{/if}}
  {{#if breachText}}
  <p class="sol-seuil">{{breachText}}</p>
  {{#each breachAir as |line|}}
  <p class="sol-seuil">{{line}}</p>
  {{/each}}
  {{#if breachStop}}
  <button type="button" data-action="stopBreachClock">{{localize "SOL.Breach.stop"}}</button>
  {{/if}}
  {{/if}}
  {{/if}}

  {{> "systems/sol-nouvelle-ere/templates/shared/field-groups.hbs" groups=groups}}

  {{> "systems/sol-nouvelle-ere/templates/actor/status-section.hbs"}}

  <div class="sol-item-groups">
    {{#each sections as |section|}}
      {{> "systems/sol-nouvelle-ere/templates/actor/item-section.hbs" section=section}}
    {{/each}}
  </div>
</section>
