{{!--
  Feuille générique (Créature, Synthétique, Drone, Véhicule, Vaisseau).
  Les champs viennent du schéma du type. Nom lu dans document._source.
  Objets groupés par type, même partiel que le personnage.
  Réf. LdR v0.2 §15 : pas d'autres champs que ceux du modèle.
--}}
<section class="sol-sheet">
  <header class="sol-header">
    <img class="sol-portrait" src="{{actor.img}}" alt="{{docSource.name}}"
         data-action="editImage" data-edit="img" data-tooltip="{{localize 'SOL.Sheet.EditImage'}}">
    <div class="sol-identity">
      <p class="sol-type">{{localize typeLabel}}</p>
      <label for="{{rootId}}-name">{{localize "SOL.Sheet.Name"}}</label>
      <input id="{{rootId}}-name" type="text" name="name" value="{{docSource.name}}">
    </div>
  </header>

  {{> "systems/sol-nouvelle-ere/templates/shared/field-groups.hbs" groups=groups}}

  <div class="sol-item-groups">
    {{#each sections as |section|}}
      {{> "systems/sol-nouvelle-ere/templates/actor/item-section.hbs" section=section}}
    {{/each}}
  </div>
</section>
