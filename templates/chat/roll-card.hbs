{{!--
  Carte de jet D100. Les textes sont déjà traduits dans module/dice/chat.mjs
  (résultat, zone). Les libellés de ligne passent par localize.
  Réf. LdR v0.2 §2 et §7. Le bouton n'est là que si les drapeaux
  d'attaque existent : les cartes de l'étape 4 n'en ont pas.
--}}
<article class="sol-nouvelle-ere sol-roll-card">
  <h4 class="sol-roll-title">{{label}}</h4>
  <ul class="sol-roll-lines">
    <li>{{localize "SOL.Roll.score"}} : {{score}}</li>
    <li>{{localize "SOL.Roll.difficulty"}} : {{difficultyLabel}} ({{difficultyModifier}})</li>
    <li>{{localize "SOL.Roll.free"}} : {{free}}</li>
    {{#if rangeLabel}}
    <li>{{localize "SOL.Roll.range"}} : {{rangeLabel}}</li>
    {{/if}}
    {{#if calledLabel}}
    <li>{{calledLabel}}</li>
    {{/if}}
    {{#if aimModifier}}
    <li>{{localize "SOL.Roll.aim"}} : {{aimActions}} ({{aimModifier}})</li>
    {{/if}}
    {{#if statusLabel}}
    <li>{{statusLabel}} ({{statusModifier}})</li>
    {{/if}}
    <li>{{localize "SOL.Roll.total"}} : {{total}}</li>
    <li>{{localize "SOL.Roll.target"}} : {{target}}</li>
    <li>{{localize "SOL.Roll.die"}} : {{die}}</li>
    <li class="sol-result {{resultClass}}">{{result}}</li>
    <li>{{degreeLabel}} : {{degree}}</li>
    {{#if note}}
    <li class="sol-damage-remind">{{note}}</li>
    {{/if}}
    {{#if location}}
    <li>{{localize "SOL.Roll.location"}} : {{location}}</li>
    {{#if visor}}
    <li>{{localize "SOL.Roll.visorHit"}}</li>
    {{/if}}
    <li>{{localize "SOL.Roll.damage"}} : {{damage}}</li>
    {{/if}}
  </ul>
  {{#if canApply}}
  <button type="button" data-action="sol-apply-damage">{{localize "SOL.Damage.apply"}}</button>
  {{/if}}
  {{#if canApplyShip}}
  <button type="button" data-action="sol-apply-ship">{{localize "SOL.Ship.applyDamage"}}</button>
  {{/if}}
</article>
