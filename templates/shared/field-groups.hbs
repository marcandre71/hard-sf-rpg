{{!--
  Groupes de champs produits par prepareFieldGroups (module/sheets/prepare-fields.mjs).
  Chaque ligne est un DataField rendu par formGroup : le type d'input
  (nombre, case, liste, texte enrichi) vient du schéma, pas du gabarit.
  localize=true résout les clés i18n des libellés et des choix (valeur → clé).
  Un nombre reçoit type="number" : sinon min+max (Formation) devient un curseur.
--}}
{{#each groups as |group|}}
  {{#if group.label}}
  <fieldset class="sol-fieldset">
    <legend>{{localize group.label}}</legend>
    <div class="sol-fields">
      {{#each group.rows as |row|}}
        {{#if row.disabled}}
          {{formGroup row.field name=row.name value=row.value rootId=row.rootId label=row.label localize=true disabled=true hint=row.hint}}
        {{else}}
          {{#if row.number}}
          {{formGroup row.field name=row.name value=row.value rootId=row.rootId label=row.label localize=true type="number"}}
          {{else}}
          {{formGroup row.field name=row.name value=row.value rootId=row.rootId label=row.label localize=true}}
          {{/if}}
        {{/if}}
      {{/each}}
    </div>
  </fieldset>
  {{else}}
  <div class="sol-fields">
    {{#each group.rows as |row|}}
        {{#if row.disabled}}
          {{formGroup row.field name=row.name value=row.value rootId=row.rootId label=row.label localize=true disabled=true hint=row.hint}}
        {{else}}
          {{#if row.number}}
          {{formGroup row.field name=row.name value=row.value rootId=row.rootId label=row.label localize=true type="number"}}
          {{else}}
          {{formGroup row.field name=row.name value=row.value rootId=row.rootId label=row.label localize=true}}
          {{/if}}
        {{/if}}
    {{/each}}
  </div>
  {{/if}}
{{/each}}
