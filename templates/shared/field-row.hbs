{{!--
  Une ligne de prepareFieldGroups.
  decimal (delta-v, pas 0,1) : input écrit ici, pas par formGroup.
  formGroup passe par createNumberInput, qui force input.type="number"
  (doc v14). type="text" et inputmode seraient ignorés : « 3,5 » n'arrive
  pas, et un navigateur qui refuse la virgule vide la case.
  @see https://foundryvtt.com/api/v14/functions/foundry.applications.fields.createNumberInput.html
  Décision Marc 25/10/2026. Réf. Vaisseaux v0.1 §2.
--}}
{{#if row.decimal}}
<div class="form-group">
  <label for="{{row.rootId}}-{{row.name}}">{{localize row.label}}</label>
  <div class="form-fields">
    <input type="text" inputmode="decimal" id="{{row.rootId}}-{{row.name}}" name="{{row.name}}" value="{{row.value}}"{{#if row.disabled}} disabled{{/if}}>
  </div>
  {{#if row.hint}}
  <p class="hint">{{localize row.hint}}</p>
  {{/if}}
</div>
{{else}}
  {{#if row.disabled}}
  {{formGroup row.field name=row.name value=row.value rootId=row.rootId label=row.label localize=true disabled=true hint=row.hint}}
  {{else}}
    {{#if row.number}}
    {{formGroup row.field name=row.name value=row.value rootId=row.rootId label=row.label localize=true type="number"}}
    {{else}}
    {{formGroup row.field name=row.name value=row.value rootId=row.rootId label=row.label localize=true}}
    {{!-- La case garde la clé stockée. La ligne dit le libellé. Décision Marc 31/10/2026. --}}
    {{#if row.reading}}
    <p class="sol-admin-reading">{{row.reading}}</p>
    {{/if}}
    {{/if}}
  {{/if}}
{{/if}}
