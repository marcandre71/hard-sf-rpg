{{!--
  Caractéristiques en cartes : abréviation, actuelle, nom, puis les saisies.
  L'actuelle est dérivée (pas un input). Les autres cases restent éditables.
  Le bouton lance rollCharacteristic. Réf. Fiche v0.2 §4.
--}}
<div class="sol-chars">
  {{#each characteristics as |c|}}
  <div class="sol-ch" data-characteristic="{{c.key}}">
    <button type="button" class="sol-ch-roll sol-roll-characteristic" data-action="rollCharacteristic" data-characteristic="{{c.key}}">
      <i class="fa-solid fa-dice-d20" aria-hidden="true"></i>
      <span class="sol-abbr">{{localize c.abbr}}</span>
    </button>
    <output class="sol-ch-value">{{c.value}}</output>
    <span class="sol-lbl">{{localize c.label}}</span>
    <label class="sol-ch-field">
      <span class="sol-lbl">{{localize ../bounds.base.label}}</span>
      <input type="number" name="{{c.path}}.base" value="{{c.base}}" min="{{../bounds.base.min}}" max="{{../bounds.base.max}}" step="1">
    </label>
    <label class="sol-ch-field">
      <span class="sol-lbl">{{localize ../bounds.origin.label}}</span>
      <input type="number" name="{{c.path}}.origin" value="{{c.origin}}" min="{{../bounds.origin.min}}" max="{{../bounds.origin.max}}" step="1">
    </label>
    <label class="sol-ch-field">
      <span class="sol-lbl">{{localize ../bounds.advance.label}}</span>
      <input type="number" name="{{c.path}}.advance" value="{{c.advance}}" min="{{../bounds.advance.min}}" max="{{../bounds.advance.max}}" step="1">
    </label>
    <label class="sol-ch-field">
      <span class="sol-lbl">{{localize ../bounds.temp.label}}</span>
      <input type="number" name="{{c.path}}.temp" value="{{c.temp}}" step="1">
    </label>
  </div>
  {{/each}}
</div>
