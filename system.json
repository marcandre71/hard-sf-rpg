{
  "id": "sol-nouvelle-ere",
  "title": "Sol, Nouvelle Ère",
  "description": "Jeu de rôle de science-fiction réaliste (hard SF) dans le système solaire. 0.6.0 : armure par zone, brèche au seuil, tir visé, Endurance à 0.",
  "version": "0.6.0",
  "compatibility": {
    "minimum": "14",
    "verified": "14"
  },
  "authors": [
    {
      "name": "Marc-André Potheret",
      "url": "https://github.com/marcandre71/hard-sf-rpg"
    }
  ],
  "url": "https://github.com/marcandre71/hard-sf-rpg",
  "esmodules": ["module/sol.mjs"],
  "styles": ["styles/sol.css"],
  "languages": [
    {
      "lang": "fr",
      "name": "Français",
      "path": "lang/fr.json"
    },
    {
      "lang": "en",
      "name": "English",
      "path": "lang/fr.json"
    }
  ],
  "documentTypes": {
    "Actor": {
      "character": {
        "htmlFields": ["biography", "notes"]
      },
      "npc": {
        "htmlFields": ["biography", "notes"]
      },
      "creature": {
        "htmlFields": ["description", "notes"]
      },
      "synthetic": {
        "htmlFields": ["description", "notes"]
      },
      "drone": {
        "htmlFields": ["description", "notes"]
      },
      "vehicle": {
        "htmlFields": ["description"]
      },
      "ship": {
        "htmlFields": ["description"]
      }
    },
    "Item": {
      "skill": {
        "htmlFields": ["description"]
      },
      "talent": {
        "htmlFields": ["description", "effect"]
      },
      "origin": {
        "htmlFields": ["description"]
      },
      "background": {
        "htmlFields": ["description"]
      },
      "profession": {
        "htmlFields": ["description"]
      },
      "weapon": {
        "htmlFields": ["description"]
      },
      "armor": {
        "htmlFields": ["description"]
      },
      "gear": {
        "htmlFields": ["description"]
      },
      "augmentation": {
        "htmlFields": ["description", "effect", "sideEffects"]
      },
      "substance": {
        "htmlFields": ["description"]
      },
      "injury": {
        "htmlFields": ["description"]
      },
      "sequel": {
        "htmlFields": ["description", "effect"]
      },
      "software": {
        "htmlFields": ["description"]
      },
      "shipModule": {
        "htmlFields": ["description", "effects"]
      }
    }
  },
  "grid": {
    "distance": 1,
    "units": "m"
  },
  "packs": [
    {
      "name": "skills",
      "label": "Compétences",
      "path": "packs/skills",
      "type": "Item",
      "system": "sol-nouvelle-ere"
    },
    {
      "name": "talents",
      "label": "Atouts",
      "path": "packs/talents",
      "type": "Item",
      "system": "sol-nouvelle-ere"
    },
    {
      "name": "origins",
      "label": "Origines",
      "path": "packs/origins",
      "type": "Item",
      "system": "sol-nouvelle-ere"
    },
    {
      "name": "backgrounds",
      "label": "Milieux",
      "path": "packs/backgrounds",
      "type": "Item",
      "system": "sol-nouvelle-ere"
    },
    {
      "name": "professions",
      "label": "Professions",
      "path": "packs/professions",
      "type": "Item",
      "system": "sol-nouvelle-ere"
    },
    {
      "name": "weapons",
      "label": "Armes",
      "path": "packs/weapons",
      "type": "Item",
      "system": "sol-nouvelle-ere"
    },
    {
      "name": "armors",
      "label": "Armures et vêtements",
      "path": "packs/armors",
      "type": "Item",
      "system": "sol-nouvelle-ere"
    },
    {
      "name": "gear",
      "label": "Équipement",
      "path": "packs/gear",
      "type": "Item",
      "system": "sol-nouvelle-ere"
    },
    {
      "name": "augmentations",
      "label": "Augmentations",
      "path": "packs/augmentations",
      "type": "Item",
      "system": "sol-nouvelle-ere"
    },
    {
      "name": "substances",
      "label": "Substances",
      "path": "packs/substances",
      "type": "Item",
      "system": "sol-nouvelle-ere"
    },
    {
      "name": "software",
      "label": "Logiciels",
      "path": "packs/software",
      "type": "Item",
      "system": "sol-nouvelle-ere"
    },
    {
      "name": "ship-modules",
      "label": "Modules de vaisseau",
      "path": "packs/ship-modules",
      "type": "Item",
      "system": "sol-nouvelle-ere"
    },
    {
      "name": "sequels",
      "label": "Séquelles",
      "path": "packs/sequels",
      "type": "Item",
      "system": "sol-nouvelle-ere"
    },
    {
      "name": "universe",
      "label": "Univers et factions",
      "path": "packs/universe",
      "type": "JournalEntry",
      "system": "sol-nouvelle-ere"
    },
    {
      "name": "tables",
      "label": "Tables",
      "path": "packs/tables",
      "type": "RollTable",
      "system": "sol-nouvelle-ere"
    }
  ],
  "packFolders": [
    {
      "name": "Objets",
      "sorting": "m",
      "color": "#3d5a4c",
      "packs": [
        "skills",
        "talents",
        "origins",
        "backgrounds",
        "professions",
        "weapons",
        "armors",
        "gear",
        "augmentations",
        "substances",
        "software",
        "ship-modules",
        "sequels"
      ],
      "folders": []
    },
    {
      "name": "Journal",
      "sorting": "m",
      "color": "#3d4f6b",
      "packs": ["universe"],
      "folders": []
    },
    {
      "name": "Tables",
      "sorting": "m",
      "color": "#6b5340",
      "packs": ["tables"],
      "folders": []
    }
  ],
  "socket": false,
  "flags": {
    "hotReload": {
      "extensions": ["css", "hbs", "json"],
      "paths": ["styles", "templates", "lang"]
    }
  }
}
