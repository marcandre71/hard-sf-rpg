{
  "id": "sol-nouvelle-ere",
  "title": "Sol, Nouvelle Ère",
  "description": "Jeu de rôle de science-fiction réaliste (hard SF) dans le système solaire. Étape 3 : mise en page des feuilles (onglets), textes en français.",
  "version": "0.3.0",
  "compatibility": {
    "minimum": "14",
    "verified": "14"
  },
  "authors": [
    {
      "name": "Marc-André Potheret",
      "url": "https://github.com/marcandre71/hard-sf-rpg"
    }
  ],
  "url": "https://github.com/marcandre71/hard-sf-rpg",
  "esmodules": ["module/sol.mjs"],
  "styles": ["styles/sol.css"],
  "languages": [
    {
      "lang": "fr",
      "name": "Français",
      "path": "lang/fr.json"
    },
    {
      "lang": "en",
      "name": "English",
      "path": "lang/fr.json"
    }
  ],
  "documentTypes": {
    "Actor": {
      "character": {
        "htmlFields": ["biography", "notes"]
      },
      "npc": {
        "htmlFields": ["biography", "notes"]
      },
      "creature": {
        "htmlFields": ["description", "notes"]
      },
      "synthetic": {
        "htmlFields": ["description", "notes"]
      },
      "drone": {
        "htmlFields": ["description", "notes"]
      },
      "vehicle": {
        "htmlFields": ["description"]
      },
      "ship": {
        "htmlFields": ["description"]
      }
    },
    "Item": {
      "skill": {
        "htmlFields": ["description"]
      },
      "talent": {
        "htmlFields": ["description", "effect"]
      },
      "origin": {
        "htmlFields": ["description"]
      },
      "background": {
        "htmlFields": ["description"]
      },
      "profession": {
        "htmlFields": ["description"]
      },
      "weapon": {
        "htmlFields": ["description"]
      },
      "armor": {
        "htmlFields": ["description"]
      },
      "gear": {
        "htmlFields": ["description"]
      },
      "augmentation": {
        "htmlFields": ["description", "effect", "sideEffects"]
      },
      "substance": {
        "htmlFields": ["description"]
      },
      "injury": {
        "htmlFields": ["description"]
      },
      "sequel": {
        "htmlFields": ["description", "effect"]
      },
      "software": {
        "htmlFields": ["description"]
      },
      "shipModule": {
        "htmlFields": ["description", "effects"]
      }
    }
  },
  "grid": {
    "distance": 1,
    "units": "m"
  },
  "socket": false,
  "flags": {
    "hotReload": {
      "extensions": ["css", "hbs", "json"],
      "paths": ["styles", "templates", "lang"]
    }
  }
}
