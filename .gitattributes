# LevelDB (CURRENT, MANIFEST, .ldb, .log) : binaire, pas de conversion CRLF sous Windows.
packs/** binary
# `binary` pose aussi -diff et -merge. `text` ne les retire pas : on les rétablit.
packs/_source/** text eol=lf diff merge
# Le script de construction n'est pas une base LevelDB.
packs/build.mjs text eol=lf diff merge
